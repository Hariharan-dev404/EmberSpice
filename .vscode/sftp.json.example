{
    "name": "Ember Spice",
    "host": "ftpupload.net",
    "protocol": "ftp",
    "port": 21,
    "username": "YOUR_FTP_USERNAME",
    "password": "YOUR_FTP_PASSWORD",
    "remotePath": "/htdocs/",
    "secure": true,
    "uploadOnSave": false,
    "useTempFile": true,
    "ignore": [
        ".vscode",
        ".git",
        "node_modules"
    ]
}
